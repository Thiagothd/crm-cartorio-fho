# MODELO. Copie para `.env` no mesmo diretorio e preencha.
# O arquivo real fica fora do controle de versao (.gitignore, linha 14).
#
# Gere os dois segredos abaixo com valores longos e aleatorios. No PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))

# Chave que autentica QUEM CHAMA o gateway. A API .NET manda no header `apikey`.
# E' a credencial que da controle total sobre o WhatsApp pareado — trate como
# senha de producao mesmo em piloto.
AUTHENTICATION_API_KEY=troque-por-um-valor-longo-e-aleatorio

# Senha do Postgres interno do gateway. So o container usa; nao precisa ser
# memorizavel, precisa ser longa.
POSTGRES_PASSWORD=troque-por-um-valor-longo-e-aleatorio

# Como o gateway se enxerga. Em desenvolvimento na propria maquina, o valor
# abaixo serve; ele aparece nas URLs que a API do gateway devolve.
SERVER_URL=http://localhost:8080

# ERROR,WARN,INFO e' o suficiente. Acrescente DEBUG so para investigar
# pareamento — o log fica MUITO verboso e imprime conteudo de mensagem.
LOG_LEVEL=ERROR,WARN,INFO
